<Window x:Class="RenPyAutoTranslate.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RenPyAutoTranslate.Wpf.Converters"
        xmlns:local="clr-namespace:RenPyAutoTranslate.Wpf"
        xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="Ren'Py Auto Translate" Height="720" Width="1120" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}" FontFamily="Segoe UI Variable, Segoe UI">
  <Window.Resources>
    <conv:InvertBoolConverter x:Key="InvertBool" />
    <sys:BooleanToVisibilityConverter x:Key="BoolToVis" />
    <DataTemplate DataType="{x:Type local:LogLineViewModel}">
      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Timestamp}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource LogTimestampBrush}" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Top">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource LogInfoBrush}" /><Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:LogLineDisplayKind.Warn}"><Setter Property="Foreground" Value="{DynamicResource LogWarnBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:LogLineDisplayKind.Error}"><Setter Property="Foreground" Value="{DynamicResource LogErrorBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:LogLineDisplayKind.Success}"><Setter Property="Foreground" Value="{DynamicResource LogSuccessBrush}" /></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Ren'Py Auto Translate" FontSize="16" FontWeight="SemiBold" />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding ToggleThemeCommand}" Style="{StaticResource FluentIconButton}" ToolTip="{Binding ThemeToolTip}" VerticalAlignment="Center">
          <Path Data="{Binding ThemeIconPath}" Stroke="{DynamicResource WindowForegroundBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="32,28">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,20">
        <TextBlock Text="Translate game files" FontSize="26" FontWeight="SemiBold" />
      </StackPanel>

      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.18*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Source" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Translation folder" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBox Text="{Binding SourceTlPath, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource FluentTextBox}" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource GroupBoxBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="11" TextWrapping="Wrap" />
                <Button Content="Choose folder" Command="{Binding BrowseTlCommand}" Style="{StaticResource FluentSecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,16" />
                <TextBlock Text="Game" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DetectedGame}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                <TextBlock Text="Output" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBlock Text="{Binding OutputPreview}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}">
              <StackPanel>
                <TextBlock Text="Translation settings" FontSize="16" FontWeight="SemiBold" />
                <StackPanel><TextBlock Text="Source language" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding SourceLanguageOptions}" SelectedValuePath="Iso" DisplayMemberPath="DisplayName" SelectedValue="{Binding SourceIso, Mode=TwoWay}" Style="{StaticResource FluentComboBox}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" /></StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Target languages" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding StatusSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
              </Grid>
              <Border Grid.Row="1" Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,16,0,12" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="230" Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding LanguageOptions}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:LanguageOptionViewModel}">
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertBool}}" Style="{StaticResource FluentCheckBox}"><TextBlock Text="{Binding FolderName}" FontSize="12.5" /></CheckBox>
                  <TextBlock Grid.Column="1" Text="{Binding IsoLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,16">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding LastFile}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Resume" Command="{Binding ResumeCommand}" Style="{StaticResource FluentSecondaryButton}" Margin="0,0,8,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" /><Button Content="Translate" Command="{Binding TranslateCommand}" Style="{StaticResource FluentPrimaryButton}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" /><Button Content="Cancel" Command="{Binding CancelRunCommand}" Style="{StaticResource FluentDangerOutlineButton}" Margin="8,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" /></StackPanel>
              </Grid>
              <ProgressBar Grid.Row="1" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" Style="{StaticResource FluentProgressBar}" Margin="0,16,0,0" />
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="16">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock Text="Activity" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
              <ListBox Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding LogLines}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" ItemContainerStyle="{StaticResource LogListBoxItem}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Open output folder" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource FluentLinkButton}" Margin="0,0,18,0" /><Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource FluentLinkButton}" /></StackPanel>
    </Grid>
  </Grid>
</Window>
